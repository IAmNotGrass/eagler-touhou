{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eagler Touhou",
  "version": "0.1.0",
  "identifier": "top.lograss.eaglertouhou",
  "build": {
    "beforeBuildCommand": "npm run frontend",
    "beforeDevCommand": "npm run frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "东方Project 原作 STG 启动器",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
