{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The launcher window may open links to other sites in the system browser.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{"url": "https://*"}, {"url": "http://*"}, {"url": "mailto:*"}]
    }
  ]
}
